#include <stdio.h>

int main() {
    // Variable declarations
    float price1, price2, price3;
    int quantity1, quantity2, quantity3;
    float subtotal1, subtotal2, subtotal3;
    float total, payment, change;

    // Title Display
    printf("================================\n");
    printf("      SHOPPING CALCULATOR       \n");
    printf("================================\n");

    // Input for Item 1
    printf("Enter price of Item 1: ");
    scanf("%f", &price1);
    printf("Enter quantity of Item 1: ");
    scanf("%d", &quantity1);

    // Input for Item 2
    printf("Enter price of Item 2: ");
    scanf("%f", &price2);
    printf("Enter quantity of Item 2: ");
    scanf("%d", &quantity2);

    // Input for Item 3
    printf("Enter price of Item 3: ");
    scanf("%f", &price3);
    printf("Enter quantity of Item 3: ");
    scanf("%d", &quantity3);

    // Input for Cash Payment
    printf("Enter cash payment: ");
    scanf("%f", &payment);

    // Calculations
    subtotal1 = price1 * quantity1;
    subtotal2 = price2 * quantity2;
    subtotal3 = price3 * quantity3;
    
    total = subtotal1 + subtotal2 + subtotal3;
    change = payment - total;

    // Displaying the Receipt
    printf("\n----------- RECEIPT ------------\n");
    printf("Item 1 Subtotal: P%.2f\n", subtotal1);
    printf("Item 2 Subtotal: P%.2f\n", subtotal2);
    printf("Item 3 Subtotal: P%.2f\n", subtotal3);
    printf("--------------------------------\n");
    printf("Total Amount:    P%.2f\n", total);
    printf("Cash Payment:    P%.2f\n", payment);
    printf("Change:          P%.2f\n", change);
    printf("================================\n");
    printf("   Thank you for shopping!\n");
    printf("================================\n");

    return 0;
}
